  voiceSource: {fileID: 1493787917}
  audioFolderPath: Audio/Vaccination_Cutscene1
  typingSpeed: 0.01
  autoAdvanceDelay: 0.3
  dialogueLines:
  - 'Welcome to the Vaccination Module!

'
  - 'In this room, you''ll learn the basics of vaccination

'
  - 'Don''t worry, it may sound overwhelming, but I''ll be guiding you throughout
    the way.

'
  - 'Once you finish studying in this room, you should be able to identify the 4
    basic vaccines.

'
  - 'I''ll also make sure that you learn correct vaccination points for each vaccine
    and proper vaccination procedure.

'
  - 'This module will also allow you to practice the necessary vaccination skills,
    promote proper vaccination etiquette, and of course, familiarize you, with the
    common practices in the professional setting.

'
  - 'I''ve prepared a few tasks to accomplish those objectives. You can check on
    the task board from time to time to monitor your progress.

'
  - 'I''m sure you''re already raring to get started.

'
  nextSceneName: StoryMode_Vaccine
